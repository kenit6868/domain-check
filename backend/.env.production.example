# Copy .env.example to .env, then apply these production overrides.
# Fill real secrets outside source control. Never reuse the example password.
DOMAINCHECK_ENVIRONMENT=production
DOMAINCHECK_PUBLIC_HOST=tool.example.com
DOMAINCHECK_ALLOWED_ORIGINS=["https://tool.example.com"]
DOMAINCHECK_TELEGRAM_REDIRECT_URI=https://tool.example.com/api/v1/auth/telegram/callback
# URL-encode reserved characters in the password; db is the Compose service name.
DOMAINCHECK_CONTAINER_DATABASE_URL=postgresql+asyncpg://domaincheck:CHANGE_ME_LOCAL_ONLY@db:5432/domaincheck
DOMAINCHECK_BROWSER_CAPTURE_ENABLED=true
# Initial bounded capacity, not a promise of 1000-domain throughput.
DOMAINCHECK_WORKER_QUICK_REPORT_SLOTS=2
DOMAINCHECK_WORKER_CHECK_DOMAIN_SLOTS=2
DOMAINCHECK_WORKER_DOMAIN_WORKER_PRECHECK_SLOTS=2
DOMAINCHECK_WORKER_DOMAIN_WORKER_SEND_SLOTS=2
DOMAINCHECK_WORKER_BROWSER_EVIDENCE_SLOTS=1
DOMAINCHECK_WORKER_ITEMS_PER_TURN=1
DOMAINCHECK_CLOUDFLARE_RUNNER_SLOTS=2
VITE_FORM_ASSISTANT_EXTENSION_ID=REPLACE_WITH_32_LETTER_EXTENSION_ID
DOMAINCHECK_RELEASE=local
# Complete TELEGRAM_CLIENT_ID/SECRET, BOOTSTRAP_TELEGRAM_SUBJECT and
# SECRET_MASTER_KEY in .env; copy no secrets from config.ini.
# MAIL_EGRESS_ENDPOINTS and explicit provider submission flags remain intentional.
