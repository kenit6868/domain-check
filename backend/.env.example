# Copy to backend/.env for local development. Never commit real values.
# Docker Compose passes the unprefixed values only to the PostgreSQL container.
POSTGRES_DB=domaincheck
POSTGRES_USER=domaincheck
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# FastAPI runs on the host in the current dev topology, so use loopback here.
DOMAINCHECK_DATABASE_URL=postgresql+asyncpg://domaincheck:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/domaincheck
DOMAINCHECK_REDIS_URL=redis://127.0.0.1:6379/0
DOMAINCHECK_ARTIFACT_ROOT=./backend/.runtime/artifacts
DOMAINCHECK_ARTIFACT_MAX_FILE_BYTES=10485760
DOMAINCHECK_ARTIFACT_MAX_DIMENSION=16384
DOMAINCHECK_ARTIFACT_MAX_PIXELS=40000000
DOMAINCHECK_ENVIRONMENT=development
DOMAINCHECK_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DOMAINCHECK_FORM_TASK_TTL_SECONDS=300
# Explicit operator opt-in. Preview/export remain available with outbound submit off.
DOMAINCHECK_NETCRAFT_SUBMIT_ENABLED=false

# Required only for a real Telegram deployment. Tests use a mock issuer.
DOMAINCHECK_TELEGRAM_CLIENT_ID=
DOMAINCHECK_TELEGRAM_CLIENT_SECRET=
DOMAINCHECK_TELEGRAM_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/telegram/callback
DOMAINCHECK_BOOTSTRAP_TELEGRAM_SUBJECT=

# URL-safe base64 for 32 random bytes. Keep outside Git and rotate by key version.
DOMAINCHECK_SECRET_MASTER_KEY=
DOMAINCHECK_SECRET_KEY_VERSION=1
