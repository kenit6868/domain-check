{
  "manifest_version": 3,
  "name": "PhishingTool Web Form Assistant",
  "version": "2.1.0",
  "description": "Fills supported official abuse forms from local, operator-approved tasks.",
  "background": {"service_worker": "background.js"},
  "host_permissions": [
    "https://abuse.cloudflare.com/*",
    "https://safebrowsing.google.com/*",
    "https://www.microsoft.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://abuse.cloudflare.com/*",
      "https://safebrowsing.google.com/*",
      "https://www.microsoft.com/*"
    ],
    "js": [
      "adapters/cloudflare.js",
      "adapters/google_gsb.js",
      "adapters/microsoft_smartscreen.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }]
}
