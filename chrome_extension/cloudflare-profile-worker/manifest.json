{
  "manifest_version": 3,
  "name": "PhishingTool Cloudflare Form Worker",
  "version": "1.0.5",
  "description": "Fills the official Cloudflare phishing form from local, operator-approved tasks.",
  "background": {"service_worker": "background.js"},
  "host_permissions": [
    "https://abuse.cloudflare.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [{
    "matches": ["https://abuse.cloudflare.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
